# Copia este archivo como backend/.env.local (lo hace `node scripts/setup.js`)
# y completa los valores. .env.local NO se versiona. Aquí no van valores reales.

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# La base `pizzeria` ya existe: no se borra ni se recrea (el modelo se crea con migraciones Prisma).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pizzeria
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public

# Prisma usa esta URL. Mantenla coherente con los valores de arriba.
# Si la contraseña tiene caracteres especiales (@ : / # %), codifícala en URL.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/pizzeria?schema=public"

# Pruebas de integración/concurrencia: MISMA base y credenciales, pero esquema aparte `test`.
# Los tests con BD real solo escriben aquí y se omiten si esta variable no existe.
# Debe terminar en ?schema=test (nunca public). Crear el esquema con: npm run db:test:migrate
DATABASE_URL_TEST="postgresql://USUARIO:CONTRASENA@localhost:5432/pizzeria?schema=test"

# --- Auth (genera valores largos y aleatorios, >= 32 caracteres; no uses estos) ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12

CORS_ORIGINS=http://localhost:3000

# --- Límites de peticiones (express-rate-limit) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Logging (pino): fatal | error | warn | info | debug | trace | silent ---
LOG_LEVEL=info

# --- Seed (datos de ejemplo). Si las contraseñas no se definen, el seed genera una aleatoria
# por usuario y la imprime UNA sola vez en consola. ---
SEED_ADMIN_EMAIL=admin@goodpizza.local
SEED_ADMIN_PASSWORD=
SEED_CLIENT_EMAIL=cliente@goodpizza.local
SEED_CLIENT_PASSWORD=
