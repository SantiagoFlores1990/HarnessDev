# Copia este archivo como backend/.env.local (lo hace `node scripts/setup.js`)
# y completa los valores. .env.local NO se versiona.

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public

# Prisma usa esta URL. Mantenla coherente con los valores de arriba.
# Si la contraseña tiene caracteres especiales (@ : / # %), codifícala en URL.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/app_db?schema=public"

# --- Auth (genera valores largos y aleatorios; no uses estos) ---
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

CORS_ORIGINS=http://localhost:3000
